<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Price Recommendation Views - Phase 11.2 -->

    <!-- Tree View -->
    <record id="view_price_recommendation_tree" model="ir.ui.view">
        <field name="name">price.recommendation.tree</field>
        <field name="model">price.recommendation</field>
        <field name="arch" type="xml">
            <tree decoration-success="status in ('accepted', 'applied')"
                  decoration-warning="status == 'pending'"
                  decoration-danger="status == 'rejected'">
                <field name="create_date"/>
                <field name="product_id"/>
                <field name="channel_id"/>
                <field name="ai_recommended_price"/>
                <field name="cost_price"/>
                <field name="gross_profit"/>
                <field name="gross_margin" widget="progressbar"/>
                <field name="net_profit"/>
                <field name="status" widget="badge"
                    decoration-success="status in ('accepted', 'applied')"
                    decoration-warning="status == 'pending'"
                    decoration-danger="status == 'rejected'"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_price_recommendation_form" model="ir.ui.view">
        <field name="name">price.recommendation.form</field>
        <field name="model">price.recommendation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_accept" string="Accept" type="object"
                        class="btn-success" invisible="status != 'pending'"/>
                    <button name="action_reject" string="Reject" type="object"
                        class="btn-danger" invisible="status != 'pending'"/>
                    <button name="action_apply" string="Apply Price" type="object"
                        class="btn-primary" invisible="status != 'accepted'"/>
                    <field name="status" widget="statusbar"
                        statusbar_visible="pending,accepted,applied"/>
                </header>
                <sheet>
                    <group>
                        <group string="Product and Channel">
                            <field name="product_id" readonly="1"/>
                            <field name="channel_id" readonly="1"/>
                        </group>
                        <group string="Pricing">
                            <field name="ai_recommended_price"/>
                            <field name="cost_price" readonly="1"/>
                        </group>
                    </group>
                    <group string="Fees">
                        <group>
                            <field name="platform_fee"/>
                            <field name="payment_fee"/>
                        </group>
                        <group>
                            <field name="shipping_fee"/>
                            <field name="vat_amount"/>
                        </group>
                    </group>
                    <group>
                        <group string="Profit Analysis" colspan="2">
                            <field name="gross_profit" readonly="1"/>
                            <field name="gross_margin" readonly="1"/>
                            <field name="net_profit" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="recommended_reasoning"/>
                    </group>
                    <group>
                        <field name="create_date" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_price_recommendation_search" model="ir.ui.view">
        <field name="name">price.recommendation.search</field>
        <field name="model">price.recommendation</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="channel_id"/>
                <filter string="Pending" name="pending" domain="[('status', '=', 'pending')]"/>
                <filter string="Accepted" name="accepted" domain="[('status', '=', 'accepted')]"/>
                <filter string="Applied" name="applied" domain="[('status', '=', 'applied')]"/>
                <filter string="Rejected" name="rejected" domain="[('status', '=', 'rejected')]"/>
                <separator/>
                <filter string="Good Margin (>20%)" name="good_margin"
                    domain="[('gross_margin', '>', 20)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Channel" name="group_channel" context="{'group_by': 'channel_id'}"/>
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_price_recommendation" model="ir.actions.act_window">
        <field name="name">Price Recommendations</field>
        <field name="res_model">price.recommendation</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No price recommendations yet
            </p>
            <p>
                AI price recommendations will appear here when
                channel products are analyzed.
            </p>
        </field>
    </record>
</odoo>
