<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_channel_product_ai_fill_wizard" model="ir.ui.view">
        <field name="name">channel.product.ai.fill.wizard.form</field>
        <field name="model">channel.product.ai.fill.wizard</field>
        <field name="arch" type="xml">
            <form string="AI Auto-Fill Channel Product Fields">
                <group>
                    <group string="Channel Selection">
                        <field name="channel_ids" options="{'no_create': True}" />
                    </group>
                    <group string="Options">
                        <field name="fill_barcode" />
                        <field name="fill_condition" />
                        <field name="fill_brand" />
                    </group>
                    <group string="Settings">
                        <field name="limit" size="4" />
                        <field name="only_incomplete" />
                    </group>
                </group>
                <footer>
                    <button name="action_fill" string="Fill" type="object" class="btn-primary"/>
                    <button name="action_preview" string="Preview" type="object" class="btn-secondary"/>
                    <button name="action_view_products" string="View Products" type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_channel_product_ai_fill_wizard" model="ir.actions.act_window">
        <field name="name">AI Auto-Fill</field>
        <field name="res_model">channel.product.ai.fill.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>