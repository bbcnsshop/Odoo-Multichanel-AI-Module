<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_product_form_channel" model="ir.ui.view">
        <field name="name">product.product.form.channel</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name=&apos;inventory&apos;]" position="after">
                <page string="Online Channels" name="online_channels">
                    <group>
                        <group string="Available On">
                            <div class="o_row">
                                <field name="is_on_shopee" class="oe_inline" nolabel="1"/>
                                <label for="is_on_shopee" class="oe_inline mr-2" string="Shopee"/>
                                <field name="is_on_lazada" class="oe_inline" nolabel="1"/>
                                <label for="is_on_lazada" class="oe_inline mr-2" string="Lazada"/>
                                <field name="is_on_tiktok" class="oe_inline" nolabel="1"/>
                                <label for="is_on_tiktok" class="oe_inline" string="TikTok"/>
                            </div>
                        </group>
                        <group string="Actions">
                            <button name="action_add_all_channels" string="Add to All Channels" type="object" class="btn-primary"/>
                            <button name="action_sync_to_channels" string="Sync All" type="object" class="btn-secondary"/>
                        </group>
                    </group>
                    <group string="Channel Products">
                        <field name="channel_product_ids">
                            <tree editable="bottom" decoration-muted="state == &apos;draft&apos;">
                                <field name="channel_id" options="{&apos;no_create&apos;: True}"/>
                                <field name="channel_price"/>
                                <field name="ai_recommended_price" readonly="1"/>
                                <field name="channel_qty"/>
                                <field name="state" widget="badge" decoration-success="state == &apos;active&apos;" decoration-warning="state == &apos;draft&apos;"/>
                                <field name="sync_status" widget="badge" decoration-success="sync_status == &apos;synced&apos;" decoration-danger="sync_status == &apos;error&apos;"/>
                                <button name="sync_to_channel" string="Sync" type="object" icon="fa-refresh" title="Sync to Channel"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_product_product_tree_channel" model="ir.ui.view">
        <field name="name">product.product.tree.channel</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(add_to_channel_wizard.action_add_to_channel_bulk_wizard)d" string="Add to Channel" type="action" class="btn-primary" context="{&apos;active_ids&apos;: active_ids}"/>
            </xpath>
        </field>
    </record>
</odoo>
