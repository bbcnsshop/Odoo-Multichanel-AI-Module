<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ACTION -->
    <record id="action_channel_product_video" model="ir.actions.act_window">
        <field name="name">Product Videos</field>
        <field name="res_model">channel.product.video</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="context">{'search_default_group_by_channel': 1}</field>
    </record>

    <!-- SEARCH -->
    <record id="view_channel_product_video_search" model="ir.ui.view">
        <field name="name">channel.product.video.search</field>
        <field name="model">channel.product.video</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="channel_product_id"/>
                <field name="channel_id"/>
                <field name="video_type"/>
                <field name="state"/>
                <separator/>
                <filter name="main" string="Main Videos" domain="[('is_primary', '=', True)]"/>
                <filter name="uploaded" string="Uploaded" domain="[('state', '=', 'uploaded')]"/>
                <filter name="ready" string="Ready" domain="[('state', '=', 'ready')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_channel" string="Channel" context="{'group_by': 'channel_id'}"/>
                    <filter name="group_by_type" string="Video Type" context="{'group_by': 'video_type'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- TREE -->
    <record id="view_channel_product_video_tree" model="ir.ui.view">
        <field name="name">channel.product.video.tree</field>
        <field name="model">channel.product.video</field>
        <field name="arch" type="xml">
            <tree create="true" edit="true" delete="true" multi_edit="1"
                  decoration-success="state == 'uploaded'"
                  decoration-warning="state == 'uploading'"
                  decoration-danger="state == 'error'">
                <field name="channel_id"/>
                <field name="product_id"/>
                <field name="name"/>
                <field name="video_type"/>
                <field name="is_primary" widget="boolean_toggle"/>
                <field name="storage_type"/>
                <field name="duration_display"/>
                <field name="file_size_display"/>
                <field name="state" widget="badge"/>
                <field name="sync_count" string="Synced"/>
                <button name="action_play_video" string="Play" type="object" icon="fa-play-circle" invisible="not has_video"/>
                <button name="action_upload_to_platforms" string="Upload" type="object" icon="fa-upload" invisible="state != 'ready'"/>
            </tree>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_channel_product_video_form" model="ir.ui.view">
        <field name="name">channel.product.video.form</field>
        <field name="model">channel.product.video</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_ready" string="Mark Ready" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_upload_to_platforms" string="Upload to Platform" type="object" class="btn-primary" invisible="state != 'ready'"/>
                    <button name="action_reset_to_draft" string="Reset" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ready,uploading,uploaded" clickable="1"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Video Source">
                            <field name="storage_type" widget="radio"/>
                            <field name="video_url" invisible="storage_type != 'url'" required="storage_type == 'url'"/>
                            <field name="s3_url" invisible="storage_type != 's3'" required="storage_type == 's3'"/>
                        </group>
                        <group string="Product Link">
                            <field name="channel_product_id"/>
                            <field name="product_id" readonly="1"/>
                            <field name="channel_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Settings">
                            <field name="video_type"/>
                            <field name="is_primary"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Metadata">
                            <field name="duration"/>
                            <field name="duration_display" readonly="1"/>
                            <field name="resolution"/>
                        </group>
                    </group>
                    <group string="Platform Sync" colspan="2">
                        <group><field name="shopee_video_id" readonly="1"/></group>
                        <group><field name="lazada_video_id" readonly="1"/></group>
                        <group><field name="tiktok_video_id" readonly="1"/></group>
                        <group><field name="sync_count" readonly="1"/></group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- KANBAN -->
    <record id="view_channel_product_video_kanban" model="ir.ui.view">
        <field name="name">channel.product.video.kanban</field>
        <field name="model">channel.product.video</field>
        <field name="arch" type="xml">
            <kanban create="true">
                <field name="name"/>
                <field name="channel_id"/>
                <field name="video_type"/>
                <field name="is_primary"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <span class="fa fa-video-camera fa-3x" style="padding:20px; color:#7c7bad;"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong>
                                <div><field name="channel_id"/></div>
                                <div>
                                    <span class="badge badge-info"><field name="video_type"/></span>
                                    <span t-if="record.is_primary.raw_value" class="badge badge-success">Primary</span>
                                </div>
                                <div><field name="state" widget="badge"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_multichannel_media" name="Media" parent="menu_multichannel_root" sequence="30"/>
    <menuitem id="menu_channel_product_image" name="Product Images" action="action_channel_product_image" parent="menu_multichannel_media" sequence="10"/>
    <menuitem id="menu_channel_product_video" name="Product Videos" action="action_channel_product_video" parent="menu_multichannel_media" sequence="20"/>
</odoo>