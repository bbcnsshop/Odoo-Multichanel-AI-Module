<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_channel_product_tree" model="ir.ui.view">
        <field name="name">channel.product.tree</field>
        <field name="model">channel.product</field>
        <field name="arch" type="xml">
            <tree multi_edit="1" delete="false"
                  decoration-danger="sync_status == 'error'"
                  decoration-warning="state == 'draft' or has_missing_required">
                <field name="product_id" optional="show"/>
                <field name="product_category" optional="show"/>
                <field name="channel_id" optional="show" widget="badge"/>
                <field name="channel_price" optional="show" decoration-bf="1"/>
                <field name="channel_qty" optional="show"/>
                <field name="completeness_pct" optional="show"
                       widget="progressbar"
                       decoration-success="completeness_pct >= 100"
                       decoration-danger="completeness_pct &lt; 50"
                       decoration-warning="50 &lt;= completeness_pct &lt; 100"/>
                <field name="has_missing_required" invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'draft'"/>
                <field name="sync_status" widget="badge" optional="show"
                       decoration-success="sync_status == 'synced'"
                       decoration-danger="sync_status == 'error'"
                       decoration-info="sync_status == 'never'"/>
                <field name="last_sync" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_channel_product_form" model="ir.ui.view">
        <field name="name">channel.product.form</field>
        <field name="model">channel.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Product">
                            <field name="product_id" options='{"no_create": true}'/>
                            <field name="channel_id" options='{"no_create": true}'/>
                            <field name="product_category" readonly="1"/>
                        </group>
                        <group string="Pricing">
                            <field name="channel_price"/>
                            <field name="ai_recommended_price" readonly="1"/>
                            <field name="product_cost" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Stock">
                            <field name="channel_qty"/>
                            <field name="odoo_qty" readonly="1"/>
                        </group>
                        <group string="Status">
                            <field name="state" widget="badge"/>
                            <field name="sync_status" widget="badge"/>
                            <field name="last_sync" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Channel Data" name="channel_data">
                            <group>
                                <group string="Weight &amp; Dimensions">
                                    <field name="channel_weight"/>
                                    <field name="channel_length"/>
                                    <field name="channel_width"/>
                                    <field name="channel_height"/>
                                </group>
                                <group string="Product Info">
                                    <field name="channel_brand"/>
                                    <field name="channel_video_url"/>
                                </group>
                            </group>
                            <group string="Description">
                                <field name="channel_description" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Data Completeness" name="completeness">
                            <field name="channel_completeness_ids" readonly="1">
                                <tree>
                                    <field name="channel_id"/>
                                    <field name="total_required"/>
                                    <field name="total_filled"/>
                                    <field name="completeness_pct" widget="progressbar"/>
                                    <field name="status" widget="badge"/>
                                    <field name="missing_field_names"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Channel Details">
                            <group>
                                <field name="channel_product_id"/>
                                <field name="channel_url"/>
                                <field name="sync_message" readonly="1"/>
                            </group>
                        </page>
                    </notebook>

                        <page string="Images" name="images">
                            <button name="%(action_channel_product_image)d" string="Add Image" type="action"
                                    class="btn-secondary mb-2" context="{&apos;default_channel_product_id&apos;: id}"/>
                            <field name="image_ids" context="{&apos;default_channel_product_id&apos;: active_id}">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="is_primary" widget="boolean_toggle"/>
                                    <field name="source_type"/>
                                    <field name="image_url"/>
                                    <field name="upload_status" widget="badge"/>
                                    <field name="image_id_on_platform" readonly="1"/>
                                    <button name="action_upload" string="Upload" type="object" icon="fa-upload"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Variants" name="variants">
                            <div class="alert alert-info" role="alert">
                                Variants are auto-created when sync runs. Use the Attribute Mappings tab to control how Odoo attribute values appear on the platform.
                            </div>
                            <field name="variant_ids" context="{&apos;default_channel_product_id&apos;: active_id}">
                                <tree editable="bottom">
                                    <field name="product_variant_id" options="{&apos;no_create&apos;: True}"/>
                                    <field name="variant_sku" readonly="1"/>
                                    <field name="channel_price"/>
                                    <field name="channel_qty"/>
                                    <field name="channel_weight"/>
                                    <field name="platform_variant_id" readonly="1"/>
                                    <field name="sync_status" widget="badge"/>
                                    <button name="action_sync_variant" string="Sync" type="object" icon="fa-refresh"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Attribute Mappings" name="attribute_mappings">
                            <button name="%(action_attribute_wizard)d" string="Auto-generate from Odoo" type="action"
                                    class="btn-primary mb-2" context="{&apos;default_channel_product_id&apos;: id}"/>
                            <field name="attribute_mapping_ids"
                                   context="{&apos;default_channel_id&apos;: channel_id, &apos;default_channel_product_id&apos;: id}">
                                <tree editable="bottom">
                                    <field name="active" widget="boolean_toggle"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="odoo_attribute_id"/>
                                    <field name="odoo_value_id"/>
                                    <field name="platform_attr_name"/>
                                    <field name="platform_attr_value"/>
                                    <field name="is_mandatory" widget="boolean_toggle"/>
                                </tree>
                            </field>
                        </page>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_channel_product_search" model="ir.ui.view">
        <field name="name">channel.product.search</field>
        <field name="model">channel.product</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="product_id"/>
                <field name="product_category"/>
                <separator/>
                <filter name="shopee" string="Shopee" domain="[('channel_id.code', '=', 'shopee')]"/>
                <filter name="lazada" string="Lazada" domain="[('channel_id.code', '=', 'lazada')]"/>
                <filter name="tiktok" string="TikTok" domain="[('channel_id.code', '=', 'tiktok')]"/>
                <separator/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="synced" string="Synced" domain="[('sync_status', '=', 'synced')]"/>
                <filter name="error" string="Error" domain="[('sync_status', '=', 'error')]"/>
                <filter name="incomplete" string="Incomplete" domain="[('has_missing_required', '=', True)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="by_channel" string="By Channel" context='{"group_by": "channel_id"}'/>
                    <filter name="by_category" string="By Category" context='{"group_by": "product_category"}'/>
                    <filter name="by_state" string="By Status" context='{"group_by": "state"}'/>
                    <filter name="by_sync" string="By Sync" context='{"group_by": "sync_status"}'/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_channel_product" model="ir.actions.act_window">
        <field name="name">Channel Products</field>
        <field name="res_model">channel.product</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{"search_default_filter_active": 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_neutral_face">No products on channels yet</p>
        </field>
    </record>
</odoo>
